{
  "name": "duldol-content-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --env local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply duldol-content --local",
    "db:migrate:remote": "wrangler d1 migrations apply duldol-content --remote"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "jose": "^6.1.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.0",
    "miniflare": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "~3.2.0",
    "wrangler": "^4.0.0"
  }
}
